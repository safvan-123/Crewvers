# REQUIRED for production SEO: use your actual HTTPS origin, not localhost.
NEXT_PUBLIC_SITE_URL=
# Public Sanity dataset. Keep blank to run the original fallback content locally.
SANITY_PROJECT_ID=
SANITY_DATASET=production
